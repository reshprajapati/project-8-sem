PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=your_super_secret_key_at_least_32_characters_long_for_security

# Studio admin account, created by: npm run seed:admin
# Admins cannot be registered through the public signup form.
ADMIN_NAME=Studio Admin
ADMIN_EMAIL=admin@studio.local
ADMIN_PASSWORD=change_this_before_deploying

# File-based database - all data saved locally in /db/data/ directory
# No external MongoDB connection required!

# ---------------------------------------------------------------------------
# Database driver: 'file' (JSON files, no server) or 'mongo' (MongoDB)
# ---------------------------------------------------------------------------
DB_DRIVER=file

# Only read when DB_DRIVER=mongo.
# Local install:  mongodb://127.0.0.1:27017/interior_design
# Atlas:          mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/interior_design
MONGODB_URI=mongodb://127.0.0.1:27017/interior_design
